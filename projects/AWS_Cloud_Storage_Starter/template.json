{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Student portfolio project: private versioned S3 storage with encryption and public access blocked.",
  "Resources": {
    "PortfolioBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "StudentCloudStorage"
          }
        ]
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Description": "Private bucket; use authenticated AWS access, not a public website URL.",
      "Value": {
        "Ref": "PortfolioBucket"
      }
    }
  }
}
